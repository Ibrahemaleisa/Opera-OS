# ── Database ───────────────────────────────────────────────────────────
# Runtime role: MUST NOT be a superuser and MUST NOT have BYPASSRLS.
DATABASE_URL="postgresql://operra_app:operra_app_dev@localhost:5432/operra?connection_limit=20"
# Owner role: used only for migrations, RLS installation and seeding.
MIGRATION_DATABASE_URL="postgresql://operra:operra_dev@localhost:5432/operra"
# Name of the runtime role that receives grants in prisma/sql/rls.sql
DATABASE_APP_ROLE="operra_app"

# ── App ────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# 32+ random bytes, used for signing local file URLs and webhook test signatures
APP_SECRET="replace-with-openssl-rand-hex-32"
# Set to "true" only behind HTTPS (controls Secure cookie flag)
COOKIE_SECURE="false"

# ── Redis / jobs ───────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# queue = BullMQ + separate worker (pnpm worker) | inline = run jobs in-process
JOBS_MODE="queue"

# ── Storage ────────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="me-central-1"
S3_BUCKET="operra-private"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
MAX_UPLOAD_MB="25"

# ── Messaging providers (leave empty for SIMULATION mode) ─────────────
SMTP_URL=""
EMAIL_FROM="Operra <no-reply@example.com>"
UNIFONIC_APP_SID=""
UNIFONIC_SENDER_ID=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Pre-approved WhatsApp template used for business-initiated invitations (required for live WhatsApp)
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="ar"
# Shared secrets used to verify inbound provider webhooks (HMAC-SHA256)
WEBHOOK_SECRET_SIMULATION="dev-webhook-secret"
WEBHOOK_SECRET_UNIFONIC=""
WHATSAPP_APP_SECRET=""
# Token Meta sends when you subscribe the webhook (hub.verify_token)
WHATSAPP_VERIFY_TOKEN=""

# Development only (ignored when NODE_ENV=production): multiply rate limits for local E2E runs
RATE_LIMIT_MULTIPLIER="1"

# Imports up to this many rows are processed inside the request; larger ones run on the worker
IMPORT_INLINE_ROW_LIMIT="1500"

# ── Docker Compose only ────────────────────────────────────────────────
POSTGRES_USER="operra"
POSTGRES_PASSWORD="replace-me"
POSTGRES_DB="operra"
APP_DB_USER="operra_app"
# Required by Docker Compose and Vercel (the runtime connects as APP_DB_USER with it). Leave empty for
# a local setup: when set, it replaces the password in DATABASE_URL.
APP_DB_PASSWORD=""
APP_PORT="3000"

# ── Demo seed (local only) ─────────────────────────────────────────────
SEED_PASSWORD=""
