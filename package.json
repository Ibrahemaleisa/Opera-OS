{
  "name": "operra-events-os",
  "version": "0.1.0",
  "private": true,
  "description": "Operra Events OS — Arabic-first multi-tenant operations platform for Saudi event, protocol, VIP invitation and exhibition agencies.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && tsx scripts/apply-rls.ts",
    "db:migrate:dev": "prisma migrate dev && tsx scripts/apply-rls.ts",
    "db:rls": "tsx scripts/apply-rls.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx scripts/apply-rls.ts && tsx prisma/seed.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "8.21.3",
    "bullmq": "^6.3.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  }
}
